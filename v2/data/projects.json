  "projects": [
    {
      "slug": "litabmas",
      "title": "Redesign LITABMAS",
      "short": "Redesigning LITABMAS's home page so an LPPM admin can read funding, proposal pipeline and outcomes on one screen.",
      "categories": [
        "ux",
        "ui"
      ],
      "featured": true,
      "type": "Dashboard redesign",
      "role": "Product Designer",
      "cover": "img/works/litabmas/redesign-litabmas-01-cover.webp",
      "sections": {
        "overview": "LITABMAS is the research and community service module of SEVIMA Platform, where universities manage research grants from application to publication. Its home page is the first screen an LPPM admin opens every time they start work, yet answering simple questions meant opening several menus and calculating the numbers by hand. This redesign puts funding status, the proposal pipeline and outcomes on a single screen, with a clear state for every condition: full data, empty, zero and filtered results.",
        "approach": [
          {
            "title": "Follow the money",
            "text": "Funds move from source to cluster to researcher. The screen mirrors that journey instead of showing a single total."
          },
          {
            "title": "Numbers must be trustworthy",
            "text": "Every number has a clear, consistent formula: remaining funds are the total minus what has been given, and percentages come from the same figures."
          },
          {
            "title": "Design for the non-ideal day",
            "text": "Empty data, zero totals and filters without results each get a clear display, not a confusing screen."
          }
        ]
      },
