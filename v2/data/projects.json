    {
      "slug": "cappu",
      "title": "Cappu Mascot Guideline",
      "short": "Mascot guideline for Cappu, a calm and friendly purple capybara: character, colour, expressions, poses, motion and use in real products.",
      "categories": [
        "brand",
        "ui"
      ],
      "featured": true,
      "type": "Mascot guideline",
      "role": "Character Designer",
      "tools": [
        "Figma"
      ],
      "cover": "img/works/cappu/cappu-mascot-guideline-01-cover.webp",
      "sections": {
        "overview": "Cappu is a purple capybara (Capybara + Purple), a mascot designed to be relaxed and easy to befriend. It greets users, guides them and celebrates small moments with them, and a diamond on its head acts as the DIMAS signature. This guideline documents the character from personality to anatomy, construction, colour, expressions, poses, mouth and teeth detail and motion, then shows the do and don't rules and how Cappu is applied in real products as notifications, empty states and social stickers.",
        "approach": [
          {
            "title": "Relaxed, friendly, curious",
            "text": "Cappu never panics: the tone is calm and clear, it greets first in simple warm language, and it likes to invite users to try something new."
          },
          {
            "title": "A system, not a single drawing",
            "text": "Anatomy, construction and colour are documented so the character stays consistent in every expression and pose."
          },
          {
            "title": "Ready to use",
            "text": "All expressions, poses and animations are available as Figma components: pick a variant, then scale."
          }
        ]
      },
